# restream Configuration Example
# ===============================
# Copy this file to config.yaml and adjust the values.
# Environment variables in ${VAR} form are expanded at load time.

global:
  # Log level: debug | info | warn | error
  log_level: info
  # Stall-detection timeout (seconds): if FFmpeg reports no progress for this
  # long, the stream is considered stalled and restream reconnects.
  # This is the actual stall timeout, not a poll interval. Sane range: 3-60.
  health_check_interval: 10
  # /healthz status endpoint listen address (JSON: per-pipeline state, uptime,
  # last error, ffmpeg bitrate/fps, stderr tail). Empty string disables it.
  http_addr: ":8080"

pipelines:
  - name: "youtube-to-bilibili"
    # --- Source settings ---
    source:
      # Source type identifier (registered source package)
      type: youtube
      config:
        # YouTube live stream URL (required)
        url: "https://www.youtube.com/watch?v=YOUR_VIDEO_ID"
        # --- Authentication ---
        # PO Token Provider sidecar — auto, no config needed.
        #   docker-compose.yml already includes the pot-provider service.
        #   yt-dlp "auto-discovers" it ONLY if the provider is reachable at
        #   127.0.0.1:4416. Both compose services use network_mode: host so the
        #   provider binds the host's 127.0.0.1:4416. If you run restream
        #   outside Docker, make sure the provider listens on the same host.
        # --- Stream options ---
        # yt-dlp format selector (optional, defaults to "best").
        # For LIVE streams "best" (single merged HLS) is the reliable default;
        # "bestvideo+bestaudio" is VOD-oriented and usually unavailable on live
        # (yt-dlp will error). Use it only if you truly need separate tracks.
        # Examples: "best", "best[height<=1080]"
        format: ""
        # HTTP/SOCKS proxy (optional). Use if YouTube is blocked.
        # TUN mode (VPN) is preferred — no proxy config needed.
        proxy: ""
        # Force IPv4 for resolve. Usually NOT needed: if the default resolve
        # fails (e.g. a broken IPv6 path), restream automatically retries once
        # with IPv4. Set "true" only where IPv4 must always be used, such as a
        # proxy that only supports IPv4.
        force_ipv4: "false"
        # Path to a Netscape-format cookies.txt (optional), passed to yt-dlp
        # via --cookies. Required for streams behind YouTube's "Sign in to
        # confirm you're not a bot" check or members-only content. This file
        # holds login credentials — never commit it to the repo.
        cookies: ""
        # --- Alternative: "direct" source (pre-resolved URL, no yt-dlp) ---
        # Feed a signed stream URL straight to FFmpeg, skipping resolution.
        # Use when the machine running restream CANNOT resolve but CAN fetch:
        # e.g. a datacenter IP blocked by YouTube's bot check will still serve
        # signed HLS URLs. Resolve on a trusted machine and push the URL here.
        #   url:      "<signed HLS URL>"   static URL
        #   url_file: "/path/stream.url"   re-read on every resolve; rotate the
        #                                  file in place to refresh the URL
        # Codecs are unknown, so auto mode defaults to stream copy (fine for
        # H.264/AAC HLS); set ffmpeg.transcode=force for other codecs.
        # type: direct
        # config:
        #   url_file: "/etc/restream/stream.url"

    # --- Sink (destination) settings ---
    sink:
      # Sink type identifier (registered sink package)
      type: bilibili
      config:
        # RTMP ingest URL (optional; uses Bilibili default if empty)
        rtmp_url: "rtmp://live-push.bilivideo.com/live-bvc/"
        # Stream key / code (required). Supports env var expansion.
        # Bilibili gives a full rtmp URL like
        #   rtmp://live-push.bilivideo.com/live-bvc/?streamname=...&key=...&pflag=2
        # Put ONLY the "?streamname=..." part here; put the address up to
        # "live-bvc/" in rtmp_url above.
        stream_key: "${BILIBILI_STREAM_KEY}"

    # --- FFmpeg transcode settings ---
    ffmpeg:
      # Transcode mode: auto | copy | force
      #   auto  - transcode when source codec differs from target requirement
      #   copy  - stream copy (no transcoding, lowest CPU)
      #   force - always transcode regardless of codec compatibility
      transcode: auto
      # Video encoder (used when transcode != copy)
      video_encoder: libx264
      # x264 preset: ultrafast | superfast | veryfast | faster | fast | medium | slow | slower | veryslow
      preset: veryfast
      # Constant Rate Factor: 0-51 (lower = better quality, larger file)
      crf: 23
      # Audio encoder: aac | libmp3lame | libopus | copy
      audio_encoder: aac
      # Audio bitrate: 64k | 128k | 192k | 256k | 320k
      audio_bitrate: 128k
      # Resolution scaling (optional, used when transcoding). Empty = no scaling.
      # Examples: "-1:720" for 720p with proportional width, "1280:720" for exact
      # scale: ""
      # Encoder threads (default 2 ≈ ~200MB for 1080p x264). Set 0 to keep
      # ffmpeg's own default (one per CPU core, highest memory).
      threads: 2
      # Uplink video bitrate cap (default "8M", near Bilibili's 8000kbps limit).
      # Adds -maxrate 8M -bufsize 8M. Only affects re-encoded (transcoded)
      # video; copy mode forwards the source bitrate unchanged. Empty = no cap.
      maxrate: "8M"
      # HTTP/SOCKS proxy for the HLS pull (ffmpeg -http_proxy). Set when the
      # source URL is IP-bound to the resolving proxy exit — YouTube's signed
      # URLs 403 on segments fetched from a different IP — and when YouTube
      # is blocked on the direct path. Usually mirrors source.config.proxy.
      # proxy: "http://127.0.0.1:7897"

    # --- Auto-reconnect / retry settings ---
    retry:
      # Maximum retry attempts (0 = unlimited retries)
      max_retries: 0
      # Initial backoff interval in seconds
      initial_interval: 5
      # Maximum backoff interval in seconds
      max_interval: 60
      # Exponential backoff multiplier per retry
      backoff_multiplier: 2.0

  # You can define additional pipelines here by adding more items.
  # Each pipeline runs concurrently.
  # - name: "another-pipeline"
  #   source:
  #     type: youtube
  #     config:
  #       url: "https://www.youtube.com/watch?v=ANOTHER_ID"
  #   sink:
  #     type: bilibili
  #     config:
  #       stream_key: "${BILIBILI_STREAM_KEY_2}"
